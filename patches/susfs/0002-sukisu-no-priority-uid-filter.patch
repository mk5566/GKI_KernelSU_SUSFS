From: GKI maintainers <gki-builder@localhost>
Subject: [PATCH] kernelsu: compile out the priority uid filter with the feature

SukiSU-Ultra `builtin` calls susfs_set_priority_uid_filter() and
susfs_parse_priority_app_strings() unconditionally, but SUSFS declares and
defines them only under CONFIG_KSU_SUSFS_PRIORITY_UID_FILTER, a symbol no
Kconfig in this tree declares. With the mount-only profile that feature is
off, so the calls are implicit declarations (-Werror) while the SUSFS
helpers that use the same switch/restore helpers are compiled out (leaving
those helpers unused, also -Werror). Gate the three call sites on the same
symbol so both sides stay consistent while the feature is unavailable.
Any upstream change to these lines (native guards, unconditional
definitions, or a real Kconfig declaration) fails this patch closed instead
of silently changing behavior.

diff --git a/kernel/supercall/dispatch.c b/kernel/supercall/dispatch.c
--- a/kernel/supercall/dispatch.c
+++ b/kernel/supercall/dispatch.c
@@ -474,7 +474,9 @@
             susfs_add_sus_map(arg);
             return 0;
 #endif // #ifdef CONFIG_KSU_SUSFS_SUS_MAP
+#ifdef CONFIG_KSU_SUSFS_PRIORITY_UID_FILTER
         case CMD_SUSFS_SET_PRIORITY_UID_FILTER:
             susfs_set_priority_uid_filter(arg);
             return 0;
+#endif
         case CMD_SUSFS_ENABLE_AVC_LOG_SPOOFING:
diff --git a/kernel/manager/pkg_observer.c b/kernel/manager/pkg_observer.c
--- a/kernel/manager/pkg_observer.c
+++ b/kernel/manager/pkg_observer.c
@@ -20,7 +20,9 @@
     if (current->flags & PF_EXITING)
         return;
     track_throne(false);
+#ifdef CONFIG_KSU_SUSFS_PRIORITY_UID_FILTER
     // Renew the priority uid bitmap filter
     susfs_parse_priority_app_strings();
+#endif
 }
 
@@ -34,6 +36,8 @@
     struct callback_head *cb;
 
     // Renew the getpriority uid bitmap filter
+#ifdef CONFIG_KSU_SUSFS_PRIORITY_UID_FILTER
     susfs_parse_priority_app_strings();
+#endif
 
     if (!(current->flags & PF_KTHREAD)) {
