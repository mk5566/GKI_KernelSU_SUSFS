index e84cffc..ebf4cac 100644
--- a/kernel/Kconfig
+++ b/kernel/Kconfig
@@ -18,6 +18,21 @@ config KSU_DEBUG
 	help
 	  Enable KernelSU debug mode.
 
+config KSU_SUSFS
+	bool "SUSFS mount-only integration"
+	depends on KSU=y && ARM64
+	default n
+	help
+	  Integrate SUSFS 2.3 filesystem support with the current SukiSU hooks.
+	  Requires the matching filesystem patches. Built-in kernels only.
+
+config KSU_SUSFS_SUS_MOUNT
+	bool "SUSFS mount hiding"
+	depends on KSU_SUSFS
+	default y
+	help
+	  Track KernelSU mounts and apply the app profile's unmount policy.
+
 config KSU_MANUAL_SU
     bool "Use manual su"
     depends on KSU
