diff --git a/kernel/feature/susfs.c b/kernel/feature/susfs.c
new file mode 100644
index 0000000..fcf4f3c
--- /dev/null
+++ b/kernel/feature/susfs.c
@@ -0,0 +1,68 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#include <linux/cred.h>
+#include <linux/errno.h>
+#include <linux/sched.h>
+#include <linux/susfs.h>
+
+#include "feature/susfs.h"
+#include "manager/manager_identity.h"
+#include "policy/allowlist.h"
+
+extern bool susfs_is_current_zygote_domain(void);
+
+void ksu_susfs_clear_task(void)
+{
+    susfs_clear_current_proc_umounted();
+    susfs_clear_current_proc_no_su();
+    susfs_clear_current_proc_umounted_for_zygote_next();
+}
+
+/* Called after upstream's unmount handling, while the zygote SELinux
+ * context is still active. Never unmount the shared zygote_next namespace.
+ */
+void ksu_susfs_setuid(uid_t new_uid)
+{
+    if (!susfs_is_current_zygote_domain())
+        return;
+
+    ksu_susfs_clear_task();
+    if (is_uid_manager(new_uid))
+        return;
+
+    if (!ksu_is_allow_uid_for_current(new_uid))
+        susfs_set_current_proc_no_su();
+
+    if (is_isolated_process(new_uid) ||
+        ((is_appuid(new_uid) || new_uid == WEBVIEW_ZYGOTE_UID) &&
+         ksu_uid_should_umount(new_uid)))
+        susfs_set_current_proc_umounted();
+}
+
+/* The SUSFS userspace protocol is separate from KernelSU's driver UAPI.
+ * This runs in the reboot syscall's process context, not a kprobe callback:
+ * SUSFS handlers allocate memory, copy userspace buffers, and may sleep.
+ */
+int ksu_susfs_reboot(unsigned int cmd, void __user *arg)
+{
+    if (!uid_eq(current_uid(), GLOBAL_ROOT_UID))
+        return -EPERM;
+
+    switch (cmd) {
+    case CMD_SUSFS_SHOW_VERSION:
+        susfs_show_version(&arg);
+        return 0;
+    case CMD_SUSFS_SHOW_ENABLED_FEATURES:
+        susfs_get_enabled_features(&arg);
+        return 0;
+    case CMD_SUSFS_SHOW_VARIANT:
+        susfs_show_variant(&arg);
+        return 0;
+#ifdef CONFIG_KSU_SUSFS_SUS_MOUNT
+    case CMD_SUSFS_HIDE_SUS_MNTS_FOR_NON_SU_PROCS:
+        susfs_set_hide_sus_mnts_for_non_su_procs(&arg);
+        return 0;
+#endif
+    default:
+        return -EOPNOTSUPP;
+    }
+}
