From: GKI maintainers <gki-builder@localhost>
Subject: [PATCH] kernelsu: integrate mount-only SUSFS with upstream main

Base: SukiSU-Ultra 0bca5d152f1ed8eb6ebadff4ea342a806e7a7400 (UAPI 5).
Keep upstream module blacklist and forced-feature boot handling intact.
SUSFS uses its own reboot protocol; it does not change the driver UAPI.

diff --git a/kernel/Kbuild b/kernel/Kbuild
index a9dd635..13c1c99 100644
--- a/kernel/Kbuild
+++ b/kernel/Kbuild
@@ -1,6 +1,7 @@
 kernelsu-objs := core/init.o
 
 kernelsu-objs += feature/kernel_umount.o
+kernelsu-$(CONFIG_KSU_SUSFS) += feature/susfs.o
 kernelsu-objs += feature/module_blacklist.o
 kernelsu-objs += feature/sulog.o
 kernelsu-objs += feature/sucompat.o
