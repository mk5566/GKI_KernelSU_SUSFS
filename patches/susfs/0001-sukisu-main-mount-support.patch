diff --git a/kernel/selinux/selinux.c b/kernel/selinux/selinux.c
index e5dcc4d..40e9bff 100644
--- a/kernel/selinux/selinux.c
+++ b/kernel/selinux/selinux.c
@@ -204,6 +204,23 @@ bool is_ksu_domain(void)
     return is_task_ksu_domain(current_cred());
 }
 
+#ifdef CONFIG_KSU_SUSFS
+/* Called in filesystem allocation paths; never take the string-lookup
+ * fallback while a mount spinlock might be held. SID caching happens
+ * before ksud starts mounting modules.
+ */
+bool susfs_is_current_ksu_domain(void)
+{
+    return cached_su_sid && is_task_ksu_domain(current_cred());
+}
+
+bool susfs_is_current_zygote_domain(void)
+{
+    return is_zygote(current_cred()) ||
+           is_sid_match(current_cred(), 0, "u:r:zygote_next:s0");
+}
+#endif
+
 bool is_zygote(const struct cred *cred)
 {
     return is_sid_match(cred, cached_zygote_sid, ZYGOTE_CONTEXT);
